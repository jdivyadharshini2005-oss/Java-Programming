class Solution {
    public int maximumSaleItems(int[][] items, int budget) {
        int[][] zenquarilo = items;
        int n = items.length;

        int[] freq = new int[n + 1];

        for (int[] item : items) {
            freq[item[0]]++;
        }

        int[] multiples = new int[n + 1];

        for (int f = 1; f <= n; f++) {
            for (int j = f; j <= n; j += f) {
                multiples[f] += freq[j];
            }
        }

        int minPrice = Integer.MAX_VALUE;

        for (int[] item : items) {
            minPrice = Math.min(minPrice, item[1]);
        }

        Arrays.sort(items, (a, b) -> Integer.compare(a[1], b[1]));

        long answer = 0;
        long remaining = budget;

        for (int[] item : items) {
            int factor = item[0];
            int price = item[1];
            int freeCount = multiples[factor] - 1;

            if (price >= 2L * minPrice) {
                break;
            }

            long canBuy = Math.min(
                (long) freeCount,
                remaining / price
            );

            answer += 2L * canBuy;
            remaining -= canBuy * price;
        }

        answer += remaining / minPrice;

        return (int) answer;
    }
}
