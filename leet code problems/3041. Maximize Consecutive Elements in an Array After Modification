class Solution {
    public int maxSelectedElements(int[] nums) {
        Arrays.sort(nums);
        HashMap<Integer, Integer> dp = new HashMap<>();
        int ans = 0;

        for (int num : nums) {
            int next = dp.getOrDefault(num, 0) + 1;
            dp.put(num + 1, next);

            int current = dp.getOrDefault(num - 1, 0) + 1;
            dp.put(num, current);

            ans = Math.max(ans, Math.max(current, next));
        }

        return ans;
    }
}
