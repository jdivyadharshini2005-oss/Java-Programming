import java.util.*;

class Solution {
    static final long MOD1 = 1000000007L;
    static final long MOD2 = 1000000009L;
    static final long BASE = 131L;

    long[] hash1, hash2;
    long[] pow1, pow2;

    public int smallestUniqueSubarray(int[] nums) {
        int n = nums.length;

        hash1 = new long[n + 1];
        hash2 = new long[n + 1];
        pow1 = new long[n + 1];
        pow2 = new long[n + 1];

        // Precompute prefix hashes and powers
        pow1[0] = 1;
        pow2[0] = 1;

        for (int i = 0; i < n; i++) {
            hash1[i + 1] =
                (hash1[i] * BASE + nums[i]) % MOD1;

            hash2[i + 1] =
                (hash2[i] * BASE + nums[i]) % MOD2;

            pow1[i + 1] = (pow1[i] * BASE) % MOD1;
            pow2[i + 1] = (pow2[i] * BASE) % MOD2;
        }

        // Binary search for minimum length
        int left = 1;
        int right = n;

        while (left < right) {
            int mid = left + (right - left) / 2;

            if (hasUniqueSubarray(mid, n)) {
                right = mid;
            } else {
                left = mid + 1;
            }
        }

        return left;
    }

    boolean hasUniqueSubarray(int len, int n) {
        HashMap<Long, Integer> map = new HashMap<>();

        // Check every subarray of this length
        for (int i = 0; i + len <= n; i++) {

            long h1 = (hash1[i + len]
                     - hash1[i] * pow1[len] % MOD1
                     + MOD1) % MOD1;

            long h2 = (hash2[i + len]
                     - hash2[i] * pow2[len] % MOD2
                     + MOD2) % MOD2;

            // Combine both hashes into one key
            long key = (h1 << 32) | h2;

            map.put(key, map.getOrDefault(key, 0) + 1);
        }

        // Check whether any subarray appears once
        for (int count : map.values()) {
            if (count == 1) {
                return true;
            }
        }

        return false;
    }
}
