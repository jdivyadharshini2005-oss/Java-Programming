
class Solution {
    public long countNonDecreasingSubarrays(int[] nums, int k) {

        int n = nums.length;

        int[] dq = new int[n];
        int head = 0;
        int tail = 0;

        long cost = 0;
        long ans = 0;

        int right = n - 1;

        for (int i = n - 1; i >= 0; i--) {

            while (head < tail && nums[dq[tail - 1]] < nums[i]) {

                int left = dq[--tail];

                int r = (head < tail) ? dq[tail - 1] : right + 1;

                cost += (long) (r - left) *
                        (nums[i] - nums[left]);
            }

            dq[tail++] = i;

            while (cost > k) {

                cost -= nums[dq[head]] - nums[right];

                if (dq[head] == right) {
                    head++;
                }

                right--;
            }

            ans += right - i + 1;
        }

        return ans;
    }
}
